<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to connectionStrings.config (git-ignored) and point it at your database. -->
<connectionStrings>
  <add name="ethos_viewer.Properties.Settings.ethosConnectionString"
       connectionString="Data Source=.;Initial Catalog=ethos;Integrated Security=True"
       providerName="System.Data.SqlClient"/>
  <!-- Azure SQL example:
       connectionString="Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=ethos;Authentication=Active Directory Default;Encrypt=True;" -->
</connectionStrings>
